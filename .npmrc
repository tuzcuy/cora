# pnpm settings. `packageManager` in package.json pins pnpm via corepack.
auto-install-peers=true
strict-peer-dependencies=false

# If a managed host's builder (e.g. Hostinger Node.js app) cannot follow pnpm's
# symlinked node_modules, switch to a flat layout — decide after the smoke test:
# node-linker=hoisted
# shamefully-hoist=true
