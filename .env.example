# ─────────────────────────────────────────────────────────────
# Cora — environment örneği. Gerçek .env repoya GİRMEZ (.gitignore).
# Yerel geliştirme: Homebrew postgres@16 + redis (bkz. docs/DECISIONS.md D-008).
# ─────────────────────────────────────────────────────────────

# --- API (apps/api) ---
NODE_ENV=development
API_PORT=3001
# Yerel dev (Homebrew): kullanıcı 'cora', DB 'cora_dev'. Şifre `pnpm dev` kurulumunda üretildi.
DATABASE_URL="postgresql://cora:CHANGE_ME@localhost:5432/cora_dev?schema=public"
REDIS_URL="redis://localhost:6379"

# Auth
JWT_ACCESS_SECRET="CHANGE_ME_ACCESS"
JWT_REFRESH_SECRET="CHANGE_ME_REFRESH"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
# Virgülle ayrılmış izin verilen web origin'leri (CORS + refresh cookie)
WEB_ORIGIN="http://localhost:3000"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE="false"

# Dosya deposu (MinIO) — yerelde YOK, deploy'da (VPS) kullanılacak
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="cora-files"
S3_ACCESS_KEY="CHANGE_ME"
S3_SECRET_KEY="CHANGE_ME"
S3_FORCE_PATH_STYLE="true"

# PDF (Gotenberg) — yerelde YOK
GOTENBERG_URL="http://localhost:3050"

# E-posta (dev: Mailpit; prod: kiracı SMTP) — yerelde YOK
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
SMTP_FROM="Cora <no-reply@corantsoft.com>"

# --- WEB (apps/web) ---
# Tarayıcıdan erişilen API tabanı (Next public)
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Sunucu tarafı (SSR) API tabanı
API_INTERNAL_URL="http://localhost:3001"

# --- WORKER (apps/worker) ---
# DATABASE_URL ve REDIS_URL yukarıdakiyle aynı
FX_TCMB_CRON="35 15 * * 1-5"
