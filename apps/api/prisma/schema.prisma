// Cora — Prisma schema (CORA_MIMARI §5.2)
// Conventions: every business table has tenantId; soft delete via deletedAt;
// optimistic lock via version on documents. Money Decimal(18,4), qty Decimal(18,3),
// rate Decimal(18,6), percentages Decimal(9,4).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Enums ───────────────────────────

enum SalesDocumentType {
  QUOTE
  ORDER
  RETURN
}

enum DocumentType {
  QUOTE
  ORDER
  SHIPMENT
  STOCK_RECEIPT
  STOCK_COUNT
  RETURN
}

enum SalesStatus {
  DRAFT
  SENT
  APPROVAL_PENDING
  APPROVED
  REJECTED
  EXPIRED
  SENT_TO_WAREHOUSE
  PICKING
  READY
  PARTIALLY_SHIPPED
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PartnerType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum AddressType {
  BILLING
  SHIPPING
}

enum StockMovementType {
  RECEIPT
  SALE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  COUNT
  RETURN_IN
}

enum StockReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum StockCountStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum ShipmentStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum WarehouseTaskStatus {
  PENDING
  PICKING
  READY
  CANCELLED
}

enum PriceKind {
  PURCHASE
  SALES
}

enum ExchangeRateSource {
  TCMB
  MANUAL
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

/// e-Document lifecycle at the integrator (P09).
enum EDocumentStatus {
  DRAFT
  QUEUED
  SENDING
  SENT
  ACCEPTED
  REJECTED
  CANCELLED
  ERROR
}

enum EDocumentKind {
  E_INVOICE
  E_ARCHIVE
  E_DESPATCH
}

enum Currency {
  TRY
  USD
  EUR
}

// ─────────────────────── Identity & tenant ───────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("Europe/Istanbul")
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  roles            Role[]
  licenses         License[]
  settingEntries   Setting[]
  partners         BusinessPartner[]
  partnerGroups    PartnerGroup[]
  brands           Brand[]
  categories       Category[]
  units            Unit[]
  products         Product[]
  priceLists       PriceList[]
  warehouses       Warehouse[]
  stockMovements   StockMovement[]
  stockReceipts    StockReceipt[]
  stockCounts      StockCount[]
  priceTiers       PriceTier[]
  eDocuments       EDocument[]
  salesDocuments   SalesDocument[]
  shipments        Shipment[]
  emailLogs        EmailLog[]
  exchangeRates    ExchangeRate[]
  documentSeqs     DocumentSequence[]
  auditLogs        AuditLog[]
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  fullName     String
  phone        String?
  isActive     Boolean   @default(true)
  repCode      String?
  lastLoginAt  DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  roles            UserRole[]
  managedPartners  BusinessPartner[] @relation("PartnerSalesRep")
  salesDocuments   SalesDocument[]   @relation("DocumentSalesRep")
  createdDocuments SalesDocument[]   @relation("DocumentCreatedBy")
  approvedDocuments SalesDocument[]  @relation("DocumentApprovedBy")
  stockMovements   StockMovement[]
  warehouseTasks   WarehouseTask[]
  postedShipments  Shipment[]        @relation("ShipmentPostedBy")
  createdShipments Shipment[]        @relation("ShipmentCreatedBy")
  createdReceipts  StockReceipt[]    @relation("ReceiptCreatedBy")
  postedReceipts   StockReceipt[]    @relation("ReceiptPostedBy")
  createdCounts    StockCount[]      @relation("CountCreatedBy")
  postedCounts     StockCount[]      @relation("CountPostedBy")
  auditLogs        AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Role {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  isSystem Boolean @default(false)

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  code  String @id
  group String

  roles RolePermission[]
}

model RolePermission {
  roleId         String
  permissionCode String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleId, permissionCode])
  @@index([permissionCode])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model License {
  id         String   @id @default(cuid())
  tenantId   String
  key        String
  modules    String[]
  userLimit  Int      @default(5)
  validUntil DateTime
  signature  String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Setting {
  id       String @id @default(cuid())
  tenantId String
  key      String
  value    Json

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId])
}

// ─────────────────────────── Cards ───────────────────────────

model PartnerGroup {
  id       String @id @default(cuid())
  tenantId String
  version   Int       @default(1)
  deletedAt DateTime?
  code     String
  name     String

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  partners BusinessPartner[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model BusinessPartner {
  id                  String      @id @default(cuid())
  tenantId            String
  version   Int       @default(1)
  code                String
  name                String
  name2               String?
  type                PartnerType @default(CUSTOMER)
  groupId             String?
  taxOffice           String?
  taxNumber           String?
  phone               String?
  email               String?
  website             String?
  city                String?
  country             String      @default("TR")
  currency            Currency    @default(TRY)
  paymentTermDays     Int         @default(0)
  paymentTerms        String?
  salesRepId          String?
  priceListId         String?
  defaultDiscountRate Decimal?    @db.Decimal(9, 4)
  creditLimit         Decimal?    @db.Decimal(18, 4)
  externalBalance     Decimal?    @db.Decimal(18, 4)
  externalBalanceDate DateTime?
  /// Manual ledger entries (payments/invoices typed in until accounting is wired).
  openingBalance      Decimal?    @db.Decimal(18, 4)
  notes               String?
  tags                String[]    @default([])
  searchText          String      @default("")
  isActive            Boolean     @default(true)
  deletedAt           DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  group     PartnerGroup?     @relation(fields: [groupId], references: [id])
  salesRep  User?             @relation("PartnerSalesRep", fields: [salesRepId], references: [id])
  priceList PriceList?        @relation(fields: [priceListId], references: [id])
  contacts  PartnerContact[]
  eDocuments EDocument[]
  addresses PartnerAddress[]
  suppliedProducts Product[]  @relation("ProductSupplier")
  salesDocuments SalesDocument[]
  shipments Shipment[]
  stockReceipts StockReceipt[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@index([tenantId, groupId])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

model PartnerContact {
  id        String  @id @default(cuid())
  partnerId String
  name      String
  title     String?
  phone     String?
  email     String?
  isPrimary Boolean @default(false)

  partner BusinessPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

model PartnerAddress {
  id         String      @id @default(cuid())
  partnerId  String
  type       AddressType @default(SHIPPING)
  title      String?
  line1      String
  line2      String?
  district   String?
  city       String?
  postalCode String?
  country    String      @default("TR")
  isDefault  Boolean     @default(false)

  partner            BusinessPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  shippedDocuments   SalesDocument[] @relation("DocumentShippingAddress")
  billedDocuments    SalesDocument[] @relation("DocumentBillingAddress")

  @@index([partnerId])
}

model Brand {
  id       String    @id @default(cuid())
  tenantId String
  version   Int       @default(1)
  name     String
  deletedAt DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Category {
  id       String    @id @default(cuid())
  tenantId String
  version   Int       @default(1)
  name     String
  parentId String?
  deletedAt DateTime?

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([tenantId, name, parentId])
  @@index([tenantId])
  @@index([parentId])
}

model Unit {
  id       String @id @default(cuid())
  tenantId String
  version   Int       @default(1)
  deletedAt DateTime?
  code     String
  name     String
  decimals Int    @default(0)

  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  baseProducts     Product[] @relation("ProductUnit")
  packageProducts  Product[] @relation("ProductPackageUnit")

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Product {
  id              String    @id @default(cuid())
  tenantId        String
  version   Int       @default(1)
  code            String
  name            String
  description     String?
  brandId         String?
  categoryId      String?
  supplierId      String?
  unitId          String
  packageUnitId   String?
  packageQty      Decimal?  @db.Decimal(18, 3)
  barcode         String?
  manufacturerCode String?
  groupCode       String?
  vatRate         Decimal   @default(20) @db.Decimal(9, 4)
  currency        Currency  @default(TRY)
  purchasePrice   Decimal   @default(0) @db.Decimal(18, 4)
  salesPrice      Decimal   @default(0) @db.Decimal(18, 4)
  minStock        Decimal   @default(0) @db.Decimal(18, 3)
  isActive        Boolean   @default(true)
  primaryImageId  String?
  attributes      Json      @default("{}")
  tags            String[]  @default([])
  searchText      String    @default("")
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  brand       Brand?           @relation(fields: [brandId], references: [id])
  category    Category?        @relation(fields: [categoryId], references: [id])
  supplier    BusinessPartner? @relation("ProductSupplier", fields: [supplierId], references: [id])
  unit        Unit             @relation("ProductUnit", fields: [unitId], references: [id])
  packageUnit Unit?            @relation("ProductPackageUnit", fields: [packageUnitId], references: [id])
  images      ProductImage[]
  priceHistory ProductPriceHistory[]
  priceListItems PriceListItem[]
  priceTiers     PriceTier[]
  stockLevels StockLevel[]
  stockMovements StockMovement[]
  stockReceiptLines StockReceiptLine[]
  stockCountLines   StockCountLine[]
  documentLines SalesDocumentLine[]
  shipmentLines ShipmentLine[]
  alternatives  ProductAlternative[] @relation("ProductAlt")
  alternativeOf ProductAlternative[] @relation("ProductAltTarget")

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@index([tenantId, brandId])
  @@index([tenantId, categoryId])
  @@index([barcode])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  objectKey String
  thumbKey  String?
  sortOrder Int    @default(0)

  /// Bytes live in the database (P06): the target host has no object storage and
  /// Render's free tier has no persistent disk. Images are small (≤2 MB) and are
  /// read by the PDF and Excel exporters as well as the UI.
  data        Bytes?
  contentType String?
  fileName    String?
  byteSize    Int?
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductPriceHistory {
  id        String    @id @default(cuid())
  productId String
  kind      PriceKind
  price     Decimal   @db.Decimal(18, 4)
  currency  Currency  @default(TRY)
  validFrom DateTime  @default(now())
  userId    String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, kind])
}

model PriceList {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  currency  Currency @default(TRY)
  /// Applied when a partner has no list of its own (P07).
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  validFrom DateTime?
  validTo   DateTime?
  note      String?
  version   Int      @default(1)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  items    PriceListItem[]
  partners BusinessPartner[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model PriceListItem {
  id           String   @id @default(cuid())
  priceListId  String
  productId    String
  price        Decimal  @db.Decimal(18, 4)
  /// Optional line discount applied on top of `price` (P07).
  discountRate Decimal? @db.Decimal(9, 4)
  updatedAt    DateTime @default(now()) @updatedAt

  priceList PriceList   @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  tiers     PriceTier[]

  @@unique([priceListId, productId])
  @@index([productId])
}

/// Quantity break: "500+ adet %5" (P07). Attached to a price-list line, or to a
/// product directly when the tier applies to everyone.
model PriceTier {
  id           String   @id @default(cuid())
  tenantId     String
  priceListId  String?
  itemId       String?
  productId    String?
  minQty       Decimal  @db.Decimal(18, 3)
  /// Either a discount off the resolved price, or an absolute unit price.
  discountRate Decimal? @db.Decimal(9, 4)
  price        Decimal? @db.Decimal(18, 4)
  createdAt    DateTime @default(now())

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  item      PriceListItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  product   Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId])
  @@index([itemId])
  @@index([priceListId])
}

model ProductAlternative {
  productId     String
  alternativeId String

  product     Product @relation("ProductAlt", fields: [productId], references: [id], onDelete: Cascade)
  alternative Product @relation("ProductAltTarget", fields: [alternativeId], references: [id], onDelete: Cascade)

  @@id([productId, alternativeId])
  @@index([alternativeId])
}

// ─────────────────────────── Stock ───────────────────────────

model Warehouse {
  id        String  @id @default(cuid())
  tenantId  String
  version   Int       @default(1)
  deletedAt DateTime?
  code      String
  name      String
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  stockReceipts  StockReceipt[]
  stockCounts    StockCount[]
  documentLines  SalesDocumentLine[]
  shipments      Shipment[]
  warehouseTasks WarehouseTask[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model StockLevel {
  id          String  @id @default(cuid())
  productId   String
  warehouseId String
  onHand      Decimal @default(0) @db.Decimal(18, 3)
  reserved    Decimal @default(0) @db.Decimal(18, 3)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

model StockMovement {
  id          String            @id @default(cuid())
  tenantId    String
  productId   String
  warehouseId String
  qty         Decimal           @db.Decimal(18, 3)
  type        StockMovementType
  refType     String?
  refId       String?
  unitCost    Decimal?          @db.Decimal(18, 4)
  note        String?
  userId      String?
  createdAt   DateTime          @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])

  @@index([tenantId, productId, warehouseId])
  @@index([tenantId, type])
  @@index([refType, refId])
  @@index([createdAt])
}

model StockReceipt {
  id           String             @id @default(cuid())
  tenantId     String
  number       String
  warehouseId  String
  supplierId   String?
  date         DateTime           @default(now())
  note         String?
  reference    String?
  currency     Currency           @default(TRY)
  exchangeRate Decimal            @default(1) @db.Decimal(18, 6)
  totalCost    Decimal            @default(0) @db.Decimal(18, 4)
  status       StockReceiptStatus @default(DRAFT)
  version      Int                @default(1)
  createdById  String?
  postedAt     DateTime?
  postedById   String?
  deletedAt    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  supplier  BusinessPartner?   @relation(fields: [supplierId], references: [id])
  createdBy User?              @relation("ReceiptCreatedBy", fields: [createdById], references: [id])
  postedBy  User?              @relation("ReceiptPostedBy", fields: [postedById], references: [id])
  lines     StockReceiptLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, date])
}

model StockReceiptLine {
  id         String  @id @default(cuid())
  receiptId  String
  lineNo     Int     @default(1)
  productId  String
  qty        Decimal @db.Decimal(18, 3)
  unitId     String?
  unitFactor Decimal @default(1) @db.Decimal(18, 3)
  unitCost   Decimal @db.Decimal(18, 4)
  lineTotal  Decimal @default(0) @db.Decimal(18, 4)
  note       String?

  receipt StockReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])

  @@index([receiptId])
  @@index([productId])
}

/// Physical stock count. Lines snapshot the system quantity when the sheet is
/// opened; posting writes COUNT movements for the difference only.
model StockCount {
  id          String           @id @default(cuid())
  tenantId    String
  number      String
  warehouseId String
  date        DateTime         @default(now())
  note        String?
  status      StockCountStatus @default(DRAFT)
  version     Int              @default(1)
  createdById String?
  postedAt    DateTime?
  postedById  String?
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  createdBy User?            @relation("CountCreatedBy", fields: [createdById], references: [id])
  postedBy  User?            @relation("CountPostedBy", fields: [postedById], references: [id])
  lines     StockCountLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model StockCountLine {
  id        String  @id @default(cuid())
  countId   String
  lineNo    Int     @default(1)
  productId String
  systemQty Decimal @default(0) @db.Decimal(18, 3)
  countedQty Decimal @default(0) @db.Decimal(18, 3)
  note      String?

  count   StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id])

  @@unique([countId, productId])
  @@index([countId])
  @@index([productId])
}

// ─────────────────────────── Sales ───────────────────────────

model SalesDocument {
  id                String            @id @default(cuid())
  tenantId          String
  type              SalesDocumentType
  number            String
  date              DateTime          @default(now())
  validUntil        DateTime?
  partnerId         String
  contactId         String?
  shippingAddressId String?
  billingAddressId  String?
  salesRepId        String?
  status            SalesStatus       @default(DRAFT)
  currency          Currency          @default(TRY)
  exchangeRate      Decimal           @default(1) @db.Decimal(18, 6)
  rateDate          DateTime?
  priceIncludesVat  Boolean           @default(false)
  subtotal          Decimal           @default(0) @db.Decimal(18, 4)
  discountTotal     Decimal           @default(0) @db.Decimal(18, 4)
  vatTotal          Decimal           @default(0) @db.Decimal(18, 4)
  grandTotal        Decimal           @default(0) @db.Decimal(18, 4)
  subtotalLocal     Decimal           @default(0) @db.Decimal(18, 4)
  vatTotalLocal     Decimal           @default(0) @db.Decimal(18, 4)
  grandTotalLocal   Decimal           @default(0) @db.Decimal(18, 4)
  costTotalLocal    Decimal           @default(0) @db.Decimal(18, 4)
  profitLocal       Decimal           @default(0) @db.Decimal(18, 4)
  marginPct         Decimal           @default(0) @db.Decimal(9, 4)
  paymentTerms      String?
  deliveryDate      DateTime?
  notes             String?
  internalNotes     String?
  reference         String?
  tags              String[]          @default([])
  sourceDocumentId  String?
  revision          Int               @default(1)
  revisedFromId     String?
  version           Int               @default(1)
  createdById       String?
  sentAt            DateTime?
  approvedAt        DateTime?
  approvedById      String?
  cancelledAt       DateTime?
  cancelReason      String?
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  partner         BusinessPartner     @relation(fields: [partnerId], references: [id])
  shippingAddress PartnerAddress?     @relation("DocumentShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddress  PartnerAddress?     @relation("DocumentBillingAddress", fields: [billingAddressId], references: [id])
  salesRep        User?               @relation("DocumentSalesRep", fields: [salesRepId], references: [id])
  createdBy       User?               @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  approvedBy      User?               @relation("DocumentApprovedBy", fields: [approvedById], references: [id])
  sourceDocument  SalesDocument?      @relation("DocumentFlow", fields: [sourceDocumentId], references: [id])
  derivedDocuments SalesDocument[]    @relation("DocumentFlow")
  revisedFrom     SalesDocument?      @relation("DocumentRevision", fields: [revisedFromId], references: [id])
  revisions       SalesDocument[]     @relation("DocumentRevision")
  lines           SalesDocumentLine[]
  statusHistory   DocumentStatusHistory[]
  warehouseTask   WarehouseTask?
  shipments       Shipment[]
  eDocuments      EDocument[]

  @@unique([tenantId, type, number])
  @@index([tenantId, type, status])
  @@index([tenantId, partnerId])
  @@index([tenantId, salesRepId])
  @@index([tenantId, date])
  @@index([sourceDocumentId])
  @@index([revisedFromId])
}

model SalesDocumentLine {
  id             String   @id @default(cuid())
  documentId     String
  lineNo         Int
  productId      String?
  description    String
  qty            Decimal  @db.Decimal(18, 3)
  unitId         String?
  unitFactor     Decimal  @default(1) @db.Decimal(18, 3)
  unitPrice      Decimal  @db.Decimal(18, 4)
  discountRate   Decimal  @default(0) @db.Decimal(9, 4)
  discountAmount Decimal  @default(0) @db.Decimal(18, 4)
  vatRate        Decimal  @default(20) @db.Decimal(9, 4)
  lineNet        Decimal  @default(0) @db.Decimal(18, 4)
  lineVat        Decimal  @default(0) @db.Decimal(18, 4)
  lineTotal      Decimal  @default(0) @db.Decimal(18, 4)
  unitCostLocal  Decimal  @default(0) @db.Decimal(18, 4)
  lineProfitLocal Decimal @default(0) @db.Decimal(18, 4)
  warehouseId    String?
  reservedQty    Decimal  @default(0) @db.Decimal(18, 3)
  pickedQty      Decimal  @default(0) @db.Decimal(18, 3)
  shippedQty     Decimal  @default(0) @db.Decimal(18, 3)
  returnedQty    Decimal  @default(0) @db.Decimal(18, 3)
  isPriceOverridden Boolean @default(false)

  document  SalesDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product   Product?      @relation(fields: [productId], references: [id])
  warehouse Warehouse?    @relation(fields: [warehouseId], references: [id])
  shipmentLines ShipmentLine[]

  @@unique([documentId, lineNo])
  @@index([documentId])
  @@index([productId])
}

model DocumentStatusHistory {
  id         String      @id @default(cuid())
  documentId String
  fromStatus SalesStatus?
  toStatus   SalesStatus
  userId     String?
  at         DateTime    @default(now())
  note       String?

  document SalesDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model WarehouseTask {
  id          String              @id @default(cuid())
  orderId     String              @unique
  warehouseId String?
  status      WarehouseTaskStatus @default(PENDING)
  assignedTo  String?
  startedAt   DateTime?
  readyAt     DateTime?
  note        String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  order     SalesDocument @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouse Warehouse?    @relation(fields: [warehouseId], references: [id])
  assignee  User?         @relation(fields: [assignedTo], references: [id])

  @@index([status])
}

model Shipment {
  id              String         @id @default(cuid())
  tenantId        String
  number          String
  orderId         String
  partnerId       String
  warehouseId     String
  date            DateTime       @default(now())
  status          ShipmentStatus @default(DRAFT)
  carrier         String?
  vehiclePlate    String?
  driverName      String?
  packageCount    Int            @default(0)
  shippingAddress Json?
  notes           String?
  version         Int            @default(1)
  createdById     String?
  deletedAt       DateTime?
  postedAt        DateTime?
  postedById      String?

  // ── UBL-TR 1.2 DespatchAdvice (e-İrsaliye). Filled locally in V1; the
  //    provider adapter in P09 only reads them.
  ublUuid              String?   // cbc:UUID (ETTN)
  ublProfileId         String    @default("TEMELIRSALIYE") // cbc:ProfileID
  ublTypeCode          String    @default("SEVK")          // cbc:DespatchAdviceTypeCode
  issueTime            DateTime?                            // cbc:IssueTime
  actualDespatchDate   DateTime?                            // cac:Shipment/cac:Delivery ActualDespatchDate
  deliveryTermsCode    String?                              // cac:DeliveryTerms
  carrierVkn           String?                              // cac:CarrierParty VKN/TCKN
  carrierTitle         String?                              // cac:CarrierParty PartyName
  driverTckn           String?                              // cac:DriverPerson
  trailerPlate         String?                              // second cac:TransportEquipment
  grossWeightKg        Decimal?  @db.Decimal(18, 3)         // cbc:GrossWeightMeasure
  packageTypeCode      String?                              // cbc:PackagingTypeCode
  gibStatus            String?                              // provider status (P09)
  gibUuid              String?
  sentToGibAt          DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  order     SalesDocument   @relation(fields: [orderId], references: [id])
  partner   BusinessPartner @relation(fields: [partnerId], references: [id])
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])
  postedBy  User?           @relation("ShipmentPostedBy", fields: [postedById], references: [id])
  createdBy User?           @relation("ShipmentCreatedBy", fields: [createdById], references: [id])
  lines     ShipmentLine[]
  eDocuments EDocument[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([orderId])
}

model ShipmentLine {
  id          String  @id @default(cuid())
  shipmentId  String
  lineNo      Int     @default(1)
  orderLineId String
  productId   String
  qty         Decimal @db.Decimal(18, 3)
  note        String?

  shipment  Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderLine SalesDocumentLine @relation(fields: [orderLineId], references: [id])
  product   Product           @relation(fields: [productId], references: [id])

  @@index([shipmentId])
  @@index([orderLineId])
}

model EmailLog {
  id         String      @id @default(cuid())
  tenantId   String
  documentId String?
  to         String
  subject    String
  status     EmailStatus @default(QUEUED)
  error      String?
  sentAt     DateTime?
  createdAt  DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
}

// ─────────────────────────── System ───────────────────────────

/// One outbound e-document (P09). Cora never holds the fiscal seal: the
/// integrator signs and files, we keep the payload, the queue state and the
/// answer we were given.
model EDocument {
  id           String          @id @default(cuid())
  tenantId     String
  kind         EDocumentKind
  status       EDocumentStatus @default(QUEUED)
  /// Source document: a Shipment (e-despatch) or a SalesDocument (e-invoice).
  shipmentId   String?
  documentId   String?
  partnerId    String?
  /// cbc:UUID — generated here so a retry cannot double-file.
  ettn         String          @unique
  /// Integrator-side identifier once accepted.
  providerId   String?
  providerName String          @default("null")
  /// GİB / integrator answer.
  responseCode String?
  responseText String?
  payload      Json?
  attempts     Int             @default(0)
  lastTriedAt  DateTime?
  sentAt       DateTime?
  acceptedAt   DateTime?
  createdById  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  shipment Shipment?        @relation(fields: [shipmentId], references: [id])
  document SalesDocument?   @relation(fields: [documentId], references: [id])
  partner  BusinessPartner? @relation(fields: [partnerId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, kind])
  @@index([shipmentId])
  @@index([documentId])
}

model ExchangeRate {
  id       String             @id @default(cuid())
  tenantId String?
  date     DateTime
  currency Currency
  rate     Decimal            @db.Decimal(18, 6)
  source   ExchangeRateSource @default(MANUAL)

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, date, currency])
  @@index([date])
}

model DocumentSequence {
  id         String       @id @default(cuid())
  tenantId   String
  docType    DocumentType
  year       Int
  prefix     String       @default("")
  lastNumber Int          @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, docType, year])
}

model AuditLog {
  id       String   @id @default(cuid())
  tenantId String
  userId   String?
  entity   String
  entityId String
  action   String
  diff     Json?
  ip       String?
  userAgent String?
  at       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, entity, entityId])
  @@index([tenantId, at])
}
